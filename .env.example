# Copy this file to ".env" (same folder) and fill in your values.
# Only NTFY_TOPIC is required.

# The ntfy topic you subscribed to in the ntfy app. Pick something
# hard to guess - anyone who knows the topic name can read/post to it.
NTFY_TOPIC=umd-dining-a7f3k9

# ntfy server. Leave as-is unless you self-host.
NTFY_SERVER=https://ntfy.sh

# Bearer token, only if your topic is access-protected.
NTFY_TOKEN=

# min | low | default | high | max
NTFY_PRIORITY=default

# Truncate each notification body to this many bytes (ntfy.sh caps ~4096).
NTFY_MAX_BYTES=3900

# Which meals to report (comma separated): breakfast, lunch, dinner, brunch
MEALS=lunch,dinner

# per-meal  -> one notification per hall per meal (up to 4/day)
# per-hall  -> one notification per hall, lunch+dinner combined (2/day)
# single    -> everything in one notification
NOTIFY_MODE=per-meal

# 1 to also list the "... Sides" stations (condiments, toppings, etc.)
INCLUDE_SIDES=0

# Cap items listed per station (0 = list everything). Helps keep the
# notification readable and under ntfy's ~4 KB message limit. With the
# default per-meal mode, 12 keeps every notification well under the cap.
MAX_ITEMS_PER_STATION=12
